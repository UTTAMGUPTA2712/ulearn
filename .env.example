# Canonical origin of the deployed site. Used for canonical URLs, sitemap,
# robots.txt, Open Graph image URLs and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ulearn-it.vercel.app

# Optional: Google Search Console verification token.
# Rendered as <meta name="google-site-verification" ...> in the root layout.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# rss2json.com free-tier API key, used server-side only to fetch the Medium
# feed (medium.com/feed/@uttamgupta2712) as JSON for /blog. Get one at
# https://rss2json.com — never prefix with NEXT_PUBLIC_, it must stay server-side.
MEDIUM_RSS2JSON_API_KEY=
